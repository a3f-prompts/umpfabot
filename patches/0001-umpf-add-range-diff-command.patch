diff --git a/tests/umpf-range-diff b/tests/umpf-range-diff
new file mode 100755
index 000000000000..bdbf6eac9836
--- /dev/null
+++ b/tests/umpf-range-diff
@@ -0,0 +1,48 @@
+#!/bin/sh
+#
+# Test comparing the patch stacks of two umpfs with "umpf range-diff".
+#
+
+# two utags with the same base
+umpf range-diff name/20221209-1 name/20240314-2 -- --no-color > range-diff.out
+git range-diff --no-color base..name/20221209-1^ base..name/20240314-2^ > range-diff.ref
+diff -u range-diff.ref range-diff.out
+
+# a qualified useries works as well
+umpf format-patch name/20240314-2 --patchdir=patches
+umpf range-diff patches/series name/20221209-1 -- --no-color > range-diff.out
+git range-diff --no-color base..name/20240314-2^ base..name/20221209-1^ > range-diff.ref
+diff -u range-diff.ref range-diff.out
+
+# rebase onto a new base, compare against HEAD (the new utag)
+git checkout -q base
+echo "new base" > newbase
+git add newbase
+git commit -q -m "new base"
+git tag -a -m "new base" newbase
+umpf tag --identical --base=newbase --version=3 name/20240314-2
+newtag="$(git describe --exact-match HEAD)"
+umpf range-diff name/20240314-2 -- --no-color --no-patch > range-diff.out
+git range-diff --no-color --no-patch base..name/20240314-2^ "newbase..${newtag}^" > range-diff.ref
+diff -u range-diff.ref range-diff.out
+test "$(wc -l < range-diff.out)" -eq 2
+
+# unqualified useries files have no patch stack
+if umpf range-diff series name/20240314-2; then
+	exit 1
+fi
+
+# the release commits are paired, although a new SUBLEVEL in their context
+# makes them differ a lot for their size
+"${TEST_DIR}/prepare-version-branch" "${TEST_DIR}/version-files/src/Makefile" Makefile
+sed -i '/^# umpf-topic: b$/a # umpf-topic: version' series
+export GIT_FALLBACK_REMOTE=refs/heads
+echo | umpf tag --version=4 series --remote=origin
+v4="$(git describe --exact-match HEAD)"
+git checkout -q version
+sed -i 's/^SUBLEVEL = 0$/SUBLEVEL = 1/' Makefile
+git commit -q -a --amend --no-edit
+echo | umpf tag --version=5 series --remote=origin
+umpf range-diff "${v4}" -- --no-color --no-patch > range-diff.out
+test "$(wc -l < range-diff.out)" -eq 4
+grep -q '^4: *[0-9a-f]* ! 4: *[0-9a-f]* Release name/' range-diff.out
diff --git a/umpf b/umpf
index fddb73cad02e..01134dcefbd5 100755
--- a/umpf
+++ b/umpf
@@ -216,6 +216,9 @@ usage() {
 	  show [<umpf>|<commit-ish>] show an useries file from an umpf
 	  tig [<umpf>]               browse an umpf interactively, showing state of
 	                             local, remote and remote-tracking topic branches
+	  range-diff <old> [<new>]   compare the patch stacks of two utags or
+	                             qualified useries files with git range-diff.
+	                             Options after '--' are passed to git.
 
 	  tag [<umpf>|<commit-ish>]  generate a utag from a useries or umerge
 	                             or commits stacked on top of an umpf
@@ -811,7 +814,7 @@ verify_topic() {
 	if ${IDENTICAL} && ! grep -q hashinfo "${STATE}/check"; then
 		abort "Cannot run identical '$(<${STATE}/command)' without 'hashinfo' (${line})!"
 	fi
-	if [ "$(<${STATE}/command)" = "format_patch" ] && ! grep -q topic-range "${STATE}/check"; then
+	if [[ "$(<${STATE}/command)" =~ ^(format_patch|range_diff)$ ]] && ! grep -q topic-range "${STATE}/check"; then
 		abort "Cannot run '$(<${STATE}/command)' without a 'topic-range' for each 'topic'!" \
 			"Maybe you need to 'tag' first?"
 	fi
@@ -2070,6 +2073,53 @@ do_continue() {
 	esac
 }
 
+### namespace: range_diff ###
+
+range_diff_base() {
+	echo "${baserev}" > "${STATE}/range-base"
+}
+
+range_diff_topic_range() {
+	echo "${content##*..}" > "${STATE}/range-tip"
+}
+
+### command: range-diff ###
+
+# set ${range} to the linear patch stack of an umpf: <base>..<last topic-range>
+range_diff_range() {
+	prepare_persistent range_diff "${1}"
+	parse_series range_diff "${STATE}/series"
+	if [ ! -e "${STATE}/range-tip" ]; then
+		abort "'${1}' contains no patches"
+	fi
+	range="$(<"${STATE}/range-base")..$(<"${STATE}/range-tip")"
+	cleanup
+}
+
+do_range_diff() {
+	local range old new
+	if [[ $# -lt 1 || "${1}" == -* ]]; then
+		info "usage: umpf range-diff <old> [<new>] [-- <git range-diff options>]"
+		exit 1
+	fi
+	range_diff_range "${1}"
+	old="${range}"
+	shift
+	if [[ $# -gt 0 && "${1}" != -* ]]; then
+		range_diff_range "${1}"
+		shift
+	else
+		range_diff_range HEAD
+	fi
+	new="${range}"
+
+	# The release commits of two umpfs differ in the version and, after a
+	# rebase, often in the context, e.g. SUBLEVEL. They are so small that
+	# the default creation factor of 60 makes them a rewrite instead of a
+	# pair. Options after '--' come later and take precedence.
+	${GIT} range-diff --creation-factor=100 "${@}" "${old}" "${new}"
+}
+
 ### command: abort ###
 
 do_abort() {

