class Context:
    def __init__(self, args):
        self.dry_run = args.dry_run
        self.bsp_dir = os.path.abspath(args.bsp_dir)
        self.bsp_remote = args.bsp_remote
        self.work_dir = os.path.abspath(args.work_dir)
        os.makedirs(self.work_dir, exist_ok=True)
        self.token = (args.token or os.environ.get("UMPFABOT_TOKEN") or
                      os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN"))
        server_url = os.environ.get("GITHUB_SERVER_URL", "https://github.com")
        self.git_env = git_env(self.token, server_url)
        self.bsp = Git(self.bsp_dir, self.git_env)
        if not self.bsp.ok("rev-parse", "--git-dir"):
            raise Error(f"{self.bsp_dir} is not a git repository")
        self.umpf_path = args.umpf

        self.config = load_config(args.config or os.path.join(self.bsp_dir, DEFAULT_CONFIG))
        self.author = self.config.author
        self.entries = self.config.entries
        # commits and tags are created by umpfabot, whatever the environment says
        name, email = parse_author(self.author)
        self.git_env.update(GIT_AUTHOR_NAME=name, GIT_AUTHOR_EMAIL=email,
                            GIT_COMMITTER_NAME=name, GIT_COMMITTER_EMAIL=email)
        self.repos: dict[str, UmpfRepo] = {}
        self.remote_tags: dict[str, dict[str, str]] = {}
        self.sha256_cache_file = os.path.join(self.work_dir, "sha256.json")

        if args.forge_state:
            forge = LocalForge(args.forge_state, self.bsp_heads)
        else:
            repo = args.repo or os.environ.get("GITHUB_REPOSITORY") or self.repo_from_remote()
            api_url = os.environ.get("GITHUB_API_URL", "https://api.github.com")
            graphql_url = os.environ.get("GITHUB_GRAPHQL_URL") or (
                "https://api.github.com/graphql" if api_url == "https://api.github.com"
                else re.sub(r"/v3/?$", "/graphql", api_url))
            if not self.token:
                raise Error("no GitHub token: use --token or set UMPFABOT_TOKEN")
            forge = GitHub(repo, self.token, api_url, graphql_url, self.dry_run)
        self.forge = DryRunForge(forge) if self.dry_run else forge
        # BSP branches staged in this run (only differs from the remote in dry-run)
        self.tips: dict[str, str] = {}

    def repo_from_remote(self) -> str:
        url = self.bsp("remote", "get-url", self.bsp_remote)
        web = web_url(url)
        if not web:
            raise Error(f"cannot derive the GitHub repository from '{url}', use --repo")
        return web.split("/", 3)[3]

    def bsp_heads(self) -> dict[str, str]:
        refs = self.bsp.remote_refs(self.bsp_remote, "refs/heads/*")
        return {ref[len("refs/heads/"):]: sha for ref, sha in refs.items()}

    @functools.cached_property
    def umpf(self) -> str:
        """the umpf executable: --umpf or the configured version"""
        if self.umpf_path:
            path = self.umpf_path
            if os.sep not in path:
                path = shutil.which(path) or path
            if not os.access(path, os.X_OK):
                raise Error(f"umpf executable '{self.umpf_path}' not found")
            return os.path.abspath(path)
        return self.fetch_umpf(self.config.umpf_repository, self.config.umpf_version)

    def fetch_umpf(self, repository: str, version: str | None) -> str:
        """the umpf script of a commit-ish in the umpf repository or, without a
        version, of the newest umpf with umpfabot's patches. Cached by commit."""
        cache = os.path.join(self.work_dir, "umpf")
        git = Git(os.path.join(cache, "git"), self.git_env)
        if not os.path.isdir(git.path):
            os.makedirs(git.path)
            git("init", "-q", "--bare")
        if version is None:
            info(f"fetching the newest umpf from {repository}...")
            git("fetch", "-q", "--no-tags", repository, "HEAD")
            sha = git.rev("FETCH_HEAD")
        # a pinned commit needs no network once it was fetched
        elif re.fullmatch(r"[0-9a-f]{40}", version) and git.rev(version):
            sha = version
        else:
            info(f"fetching umpf {version} from {repository}...")
            git("fetch", "-q", "--prune", "--no-tags", repository,
                "+refs/heads/*:refs/heads/*", "+refs/tags/*:refs/tags/*")
            sha = git.rev(version)
            if not sha and git.ok("fetch", "-q", "--no-tags", repository, version):
                # e.g. a commit only reachable from a pull request
                sha = git.rev("FETCH_HEAD")
            if not sha:
                raise Error(f"umpf version '{version}' not found in {repository}")
        script = git.show(sha, "umpf")
        if script is None:
            raise Error(f"{repository} has no umpf in {version or sha}")
        name = sha
        desc = f"umpf {sha[:12]}" + (f" ({version})" if version and version != sha else "")
        patched = self.patch_umpf(git, sha) if version is None else None
        if patched:
            applied, script = patched
            name += "-" + hashlib.sha256(script.encode()).hexdigest()[:12]
            desc += " with " + ", ".join(applied)
        path = os.path.join(cache, name, "umpf")
        if not os.path.exists(path):
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path + ".tmp", "w") as f:
                f.write(script)
            os.chmod(path + ".tmp", 0o755)
            os.replace(path + ".tmp", path)
        info(f"using {desc}")
        return path

    def patch_umpf(self, git: Git, sha: str) -> tuple[list[str], str] | None:
        """the umpf of commit sha with those patches of umpfabot that are not
        upstream yet, None if there are none or they don't apply"""
        applied = []
        with tempfile.TemporaryDirectory(dir=self.work_dir) as tmp:
            # in a temporary index, the cache is a bare repository
            index = Git(git.path, dict(git.env, GIT_INDEX_FILE=os.path.join(tmp, "index")))
            index("read-tree", sha)
            for patch in umpf_patches():
                name = os.path.basename(patch)
                apply = ["apply", "--cached", "--include=umpf"]
                if index.ok(*apply, "--check", "--reverse", patch):
                    continue
                proc = run(["git", *apply, "--3way", patch], cwd=git.path, env=index.env,
                           check=False)
                if proc.returncode != 0:
                    info(proc.stderr.strip())
                    warning(f"{name} does not apply on umpf {sha[:12]}, "
                            "using umpf without patches")
                    return None
                applied.append(name)
            return (applied, index.show("", "umpf")) if applied else None

    @functools.cached_property
    def umpf_range_diff(self) -> bool:
        """'umpf range-diff' is not available in older umpf versions"""
        proc = run([self.umpf, "--help"], check=False)
        if re.search(r"^\s+range-diff\s", proc.stdout, re.M):
            return True
        info("umpf has no range-diff command, skipping it")
        return False

    def umpf_repo(self, url: str) -> UmpfRepo:
        if url not in self.repos:
            self.repos[url] = UmpfRepo(self, url)
        self.repos[url].prepare()
        return self.repos[url]

    def tip(self, branch: str) -> str:
        if branch in self.tips:
            return self.tips[branch]
        rev = self.bsp.rev(f"refs/remotes/{self.bsp_remote}/{branch}")
        if not rev:
            raise Error(f"branch {branch} not found in {self.bsp_remote}")
        return rev

    def sha256(self, url: str) -> str | None:
        """checksum of a (release) download, None if not available (yet)"""
        cache = {}
        if os.path.exists(self.sha256_cache_file):
            with open(self.sha256_cache_file) as f:
                cache = json.load(f)
        if url in cache:
            return cache[url]
        info(f"downloading {url}...")
        h = hashlib.sha256()
        try:
            with urllib.request.urlopen(url) as resp:
                while chunk := resp.read(1 << 20):
                    h.update(chunk)
        except urllib.error.HTTPError as e:
            if e.code == 404:
                return None
            raise Error(f"downloading {url} failed: {e}") from e
        except urllib.error.URLError as e:
            if isinstance(e.reason, FileNotFoundError):
                return None
            raise Error(f"downloading {url} failed: {e}") from e
        cache[url] = h.hexdigest()
        with open(self.sha256_cache_file, "w") as f:
            json.dump(cache, f, indent=2)
        return cache[url]

    def sdk_environment_setup(self, sdk: Sdk) -> tuple[str, str] | None:
        """the root of the SDK, installed if needed, and its environment setup script"""
        root = sdk.path
        if sdk.installer:
            key = sdk.sha256 or hashlib.sha256(sdk.installer.encode()).hexdigest()
            root = os.path.join(self.work_dir, "sdk", key[:16])
            if not os.path.exists(os.path.join(root, ".umpfabot-installed")):
                self.install_sdk(sdk, root)
        if not root:
            return None
        matches = glob.glob(os.path.join(root, sdk.environment_setup))
        if len(matches) != 1:
            raise Error(f"expected one '{sdk.environment_setup}' in {root}, "
                        f"found {len(matches)}")
        return root, matches[0]

    def install_sdk(self, sdk: Sdk, root: str) -> None:
        with tempfile.TemporaryDirectory(dir=self.work_dir) as tmp:
            installer = sdk.installer
            if re.match(r"^[a-z]+://", installer):
                info(f"downloading SDK {installer}...")
                local = os.path.join(tmp, "sdk.sh")
                with urllib.request.urlopen(installer) as resp, open(local, "wb") as f:
                    shutil.copyfileobj(resp, f)
                installer = local
            if sdk.sha256:
                with open(installer, "rb") as f:
                    digest = hashlib.file_digest(f, "sha256").hexdigest() \
                        if hasattr(hashlib, "file_digest") else \
                        hashlib.sha256(f.read()).hexdigest()
                if digest != sdk.sha256:
                    raise Error(f"SDK installer checksum mismatch: {digest}")
            shutil.rmtree(root, ignore_errors=True)
            info(f"installing SDK to {root}...")
            run(["sh", installer, "-y", "-d", root])
            open(os.path.join(root, ".umpfabot-installed"), "w").close()


