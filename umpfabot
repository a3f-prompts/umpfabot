def truncate(text: str, limit: int = MAX_SECTION) -> str:
    if len(text) <= limit:
        return text
    return text[:limit] + "\n[... truncated]"


class StableUpdate:
    def __init__(self, ctx: Context, entry: Entry):
        self.ctx = ctx
        self.entry = entry
        self.prs: list[PullRequest] = []

    ### discovery ###

    def strip_prefix(self, tag: str) -> str | None:
        prefix = self.entry.tag_prefix
        return tag[len(prefix):] if tag.startswith(prefix) else None

    def stable_regex(self, base: str) -> re.Pattern:
        if self.entry.stable_release_regex:
            return re.compile(self.entry.stable_release_regex)
        version = self.strip_prefix(base)
        if version is None:
            raise Error(f"{self.entry.id}: umpf-base '{base}' does not start with "
                        f"'{self.entry.tag_prefix}'")
        # like upstream-stable-release-point.bbclass in oe-core
        parts = version.split(".")[:self.entry.stable_version_parts]
        return re.compile("^" + r"\.".join(map(re.escape, parts)) + r"(\.\d+)*$")

    def stable_tags(self, base: str) -> list[str]:
        """all stable releases of the series of base, oldest first"""
        regex = self.stable_regex(base)
        url = self.entry.upstream or self.entry.repository
        if url not in self.ctx.remote_tags:
            self.ctx.remote_tags[url] = self.ctx.bsp.remote_refs(
                url, f"refs/tags/{self.entry.tag_prefix}*")
        refs = self.ctx.remote_tags[url]
        tags = []
        for ref in refs:
            tag = ref[len("refs/tags/"):]
            version = self.strip_prefix(tag)
            if version is not None and regex.search(version):
                tags.append(tag)
        return sorted(tags, key=lambda t: version_key(self.strip_prefix(t)))

    def newer(self, a: str, b: str) -> bool:
        return version_key(self.strip_prefix(a) or a) > version_key(self.strip_prefix(b) or b)

    ### staging ###

    def tarball_sha256(self, tag: str) -> str | None:
        if not self.entry.tarball_url:
            return None
        url = format_url(self.entry.tarball_url, tag, self.strip_prefix(tag), self.entry.id)
        sha = self.ctx.sha256(url)
        if sha is None:
            raise Error(f"{url} is not available (yet)")
        return sha

    def stage(self, parent: str, base: str, reuse_utag: str | None = None) -> Staged:
        """create the BSP commit updating the umpf of parent to base"""
        entry = self.entry
        bsp = self.ctx.bsp
        text = bsp.show(parent, entry.series)
        if text is None:
            raise Error(f"{entry.series} not found in {parent}")
        old = Series(text, entry.series)
        repo = self.ctx.umpf_repo(entry.repository)
        repo.ensure_tag(old.base, entry.upstream)
        repo.ensure_tag(base, entry.upstream)
        sha256 = self.tarball_sha256(base)

        series_file = os.path.join(self.ctx.work_dir, f"{entry.id}.series.inc")
        with open(series_file, "w") as f:
            f.write(old.text)

        conflict = None
        utag = reuse_utag if reuse_utag and repo.has_tag(reuse_utag) else None
        if not utag:
            epoch = int(time.time())
            date = time.strftime("%Y%m%d", time.gmtime(epoch))
            version = repo.free_version(old.name, date, entry.tag_version)
            info(f"{entry.id}: rebasing {old.version} onto {base}...")
            try:
                utag = repo.tag(series_file, base, version, epoch)
            except UmpfConflict as e:
                conflict = e.conflict

        worktree = tempfile.mkdtemp(prefix=f"{entry.id}-", dir=self.ctx.work_dir)
        bsp("worktree", "add", "-q", "--detach", worktree, parent)
        try:
            kconfig_diff = range_diff = None
            kconfig_kept: list[tuple[str, str, str]] = []
            series_path = os.path.join(worktree, entry.series)
            if conflict:
                with open(series_path, "w") as f:
                    f.write(old.with_umpf_base(base))
            else:
                repo.umpf("format-patch", "--bb", "--update",
                          f"--patchdir={os.path.join(worktree, entry.patch_dir)}", utag)
                if entry.defconfig:
                    kconfig_diff, kconfig_kept = self.update_defconfig(
                        repo, old.version, utag, os.path.join(worktree, entry.defconfig))
                if self.ctx.umpf_range_diff:
                    proc = repo.umpf("range-diff", series_file, utag, "--", "--no-color",
                                     check=False)
                    if proc.returncode == 0:
                        range_diff = proc.stdout
                    else:
                        warning(f"{entry.id}: umpf range-diff failed: {proc.stderr.strip()}")
            if sha256:
                recipe = os.path.join(worktree, entry.recipe)
                with open(recipe) as f:
                    text = f.read()
                with open(recipe, "w") as f:
                    f.write(update_checksum(text, entry.checksum_name, sha256, entry.recipe))

            wt = Git(worktree, self.ctx.git_env)
            wt("add", "-A", "--", entry.patch_dir,
               *[p for p in (entry.recipe, entry.defconfig) if p])
            if wt.ok("diff", "--cached", "--quiet"):
                raise Error(f"updating to {base} changed nothing in the BSP")
            staged = Staged(commit="", old=old, base=base, utag=utag, conflict=conflict,
                            kconfig_diff=kconfig_diff, range_diff=range_diff, push_tags=[],
                            kconfig_kept=kconfig_kept)
            commit_args = ["commit", "-q", "--no-verify", "-F", "-"]
            if entry.signoff:
                commit_args.append("--signoff")
            wt(*commit_args, input=self.commit_message(staged))
            staged.commit = wt("rev-parse", "HEAD")
        finally:
            bsp("worktree", "remove", "--force", worktree)

        tags = [old.base, base]
        if utag:
            tags = [utag, f"{utag}-flat"] + tags
        staged.push_tags = repo.missing_remote_tags(tags)
        return staged

    def update_defconfig(self, repo: UmpfRepo, old_utag: str, utag: str,
                         defconfig: str) -> tuple[str | None, list[tuple[str, str, str]]]:
        """update the defconfig for utag. Returns the changes as diffconfig output, which
        is empty if only comments changed, or None if it did not change, and the options
        kept as checked in, see keep_environment()"""
        entry = self.entry
        sdk = self.ctx.sdk_environment_setup(entry.sdk) if entry.sdk else None
        script = self.kconfig_script(shlex.quote(sdk[1]) if sdk else None)
        if entry.container:
            image = entry.container.image
            engine = container_engine()
            info(f"{entry.id}: pulling {image}...")
            run([engine, "pull", "-q", image])
            # read-only: the defconfig comes in on stdin, the result goes out on stdout,
            # so the container creates no files owned by root here
            mounts = [repo.path] + ([sdk[0]] if sdk else [])
            cmd = [engine, "run", "--rm", "-i", "--security-opt", "label=disable",
                   *[arg for m in mounts for arg in ("-v", f"{m}:{m}:ro")],
                   "-w", repo.path, "--entrypoint", "bash", image, "-c", script]
            where = f" in {image}"
        else:
            cmd = ["bash", "-c", script]
            where = ""
        with open(defconfig) as f:
            old = f.read()

        def make(tag: str) -> str:
            repo.git("checkout", "-q", "-f", "--detach", tag)
            repo.git("clean", "-q", "-f", "-d", "-x")
            info(f"{entry.id}: make {self.make_target()}{where} for {tag}...")
            proc = run(cmd, cwd=repo.path, input=old)
            if proc.stderr.strip() and not VERBOSE:
                # the output of prepare, e.g. the compiler version, and of Kconfig
                sys.stderr.write(textwrap.indent(proc.stderr.rstrip("\n"), "  ") + "\n")
            return proc.stdout

        # what make does with the old umpf as well is due to the environment, e.g. a
        # different compiler or no Rust, and not due to the update
        kept: list[tuple[str, str, str]] = []
        if repo.has_tag(old_utag):
            before = make(old_utag)
            new, kept = keep_environment(old, before, make(utag))
            if kept:
                info(f"{entry.id}: kept {len(kept)} option(s) that make changes for "
                     f"{old_utag} as well: {', '.join(k[0] for k in kept)}")
        else:
            warning(f"{entry.id}: {old_utag} not found, so the options that only differ "
                    "because of the environment cannot be kept")
            new = make(utag)

        diff = None
        with tempfile.TemporaryDirectory(dir=self.ctx.work_dir) as tmp:
            result = os.path.join(tmp, os.path.basename(defconfig))
            with open(result, "w") as f:
                f.write(new)
            if old != new:
                diffconfig = os.path.join(repo.path, "scripts", "diffconfig")
                diff_proc = None
                if os.path.exists(diffconfig):
                    diff_proc = run([sys.executable, diffconfig, defconfig, result],
                                    check=False)
                if diff_proc and diff_proc.returncode == 0:
                    diff = diff_proc.stdout
                else:
                    diff = "".join(difflib.unified_diff(
                        old.splitlines(True), new.splitlines(True), "a/defconfig", "b/defconfig"))
            shutil.copyfile(result, defconfig)
        return diff, kept

    def kconfig_script(self, setup: str | None) -> str:
        """the bash script that updates the defconfig in the kernel checkout (the current
        directory) from stdin to stdout, in the container or on the runner. setup is the
        shell word for the SDK environment setup script"""
        entry = self.entry
        lines = ["set -e"]
        if setup:
            lines.append(f". {setup} > /dev/null")
        env = dict(entry.sdk.env if entry.sdk else {})
        # the variables of make-args as well, e.g. for ${CROSS_COMPILE}gcc in prepare
        for arg in entry.make_args:
            name, eq, value = arg.partition("=")
            if eq and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
                env[name] = value
        lines += [f"export {k}={shlex.quote(v)}" for k, v in env.items()]
        if entry.container and entry.container.prepare.strip():
            # in this shell, so it can install and set up an SDK
            lines += ["{ :", entry.container.prepare.strip("\n"), "} >&2"]
        result = "defconfig" if entry.savedefconfig else ".config"
        lines += ['build="$(mktemp -d)"',
                  "trap 'rm -rf \"$build\"' EXIT",
                  'cat > "$build/.config"',
                  'make -s O="$build" ' + shlex.join([*entry.make_args, self.make_target()])
                  + " >&2",
                  f'cat "$build/{result}"']
        return "\n".join(lines) + "\n"

    ### texts ###

    def compare_url(self, old: str, new: str) -> str | None:
        template = self.entry.compare_url
        if not template:
            web = web_url(self.entry.repository)
            if not web:
                return None
            template = web + "/compare/{old}..{new}"
        return template.format(old=old, new=new)

    def changelog_urls(self, old: str, new: str) -> list[str]:
        if not self.entry.changelog_url:
            return []
        try:
            tags = self.stable_tags(new)
        except Error:
            return []
        return [format_url(self.entry.changelog_url, t, self.strip_prefix(t), self.entry.id)
                for t in tags if self.newer(t, old) and not self.newer(t, new)]

    def subject(self, base: str) -> str:
        return f"{self.entry.commit_prefix}update to {base}"

    def review_commands(self, staged: Staged) -> tuple[list[str], str | None, str]:
        """commands to fetch both umpfs, and to view the range-diff with umpf
        (if umpfabot's umpf has range-diff) or with plain git"""
        old = staged.old
        fetch = [f"git fetch {self.entry.repository} \\",
                 f"  tag {old.base} tag {old.version} tag {staged.base} tag {staged.utag}"]
        with_umpf = None
        if self.ctx.umpf_range_diff:
            with_umpf = f"umpf range-diff {old.version} {staged.utag}"
        return (fetch, with_umpf,
                f"git range-diff {old.base}..'{old.version}^' {staged.base}..'{staged.utag}^'")

    def updated_vars(self) -> str:
        if self.entry.tarball_url:
            return "UMPF_BASE and the SRC_URI checksum are"
        return "UMPF_BASE is"

    def conflict_text(self, staged: Staged) -> str:
        c = staged.conflict
        text = f"Conflict while rebasing topic {c.topic or '(unknown)'}"
        if c.commit:
            text += f" at\n  {c.commit}"
        if c.files:
            text += "\nin\n" + "".join(f"  {f}\n" for f in c.files)
        return text.rstrip()

    def make_target(self) -> str:
        # savedefconfig fills in the defaults of new symbols just like
        # olddefconfig, so running olddefconfig first changes nothing
        return "savedefconfig" if self.entry.savedefconfig else "olddefconfig"

    def commit_message(self, staged: Staged) -> str:
        old = staged.old
        lines = [self.subject(staged.base), ""]
        if staged.conflict:
            lines += [
                textwrap.fill(f"The {old.name} umpf does not apply on top of "
                              f"{staged.base}. As a starting point for resolving this, "
                              f"only {self.updated_vars()} updated, so applying the patch "
                              "stack fails.", 72),
                "",
                self.conflict_text(staged),
            ]
        else:
            text = f"Rebase the {old.name} umpf from {old.base} onto {staged.base}"
            if self.entry.defconfig:
                text += (f" and update {os.path.basename(self.entry.defconfig)} with "
                         f"make {self.make_target()}")
            lines += [textwrap.fill(text + ".", 72)]
            lines += ["", f"Old umpf: {old.version}", f"New umpf: {staged.utag}"]
            url = self.compare_url(old.version, staged.utag)
            if url:
                lines += ["", "Diff between the old and the new umpf:", f"  {url}"]
            fetch, with_umpf, plain = self.review_commands(staged)
            lines += ["", "To review the changes to the patch stack:", ""]
            lines += [f"  {line}" for line in fetch]
            if with_umpf:
                lines += [f"  {with_umpf}", "", "or, without umpf:", ""]
            lines += [f"  {plain}"]
        return "\n".join(lines) + "\n"

    def metadata(self, staged: Staged, head: str) -> str:
        meta = {"feature": FEATURE, "id": self.entry.id, "head": head,
                "from": {"umpf": staged.old.version, "base": staged.old.base},
                "to": {"umpf": staged.utag, "base": staged.base},
                "conflict": staged.conflict is not None}
        return f"<!-- umpfabot-metadata: {json.dumps(meta, sort_keys=True)} -->"

    def pr_body(self, staged: Staged, head: str, parent: str) -> str:
        entry = self.entry
        old = staged.old
        out = [self.metadata(staged, head), ""]
        out += [f"Updates the **{old.name}** umpf of `{entry.id}` from {old.base} to "
                f"**{staged.base}**.", ""]
        if parent in self.stacked_on:
            lower = self.stacked_on[parent]
            out += [f"> [!NOTE]\n> This pull request is stacked on #{lower.number} "
                    f"({lower.target(entry.branch_prefix)}), merge that one first.", ""]
        out += ["| | umpf | base |", "|---|---|---|",
                f"| old | `{old.version}` | {old.base} |",
                f"| new | {'`' + staged.utag + '`' if staged.utag else '(conflict)'} | "
                f"{staged.base} |", ""]
        url = staged.utag and self.compare_url(old.version, staged.utag)
        if url:
            out += [f"[Diff between the old and the new umpf]({url})", ""]
        changelogs = self.changelog_urls(old.base, staged.base)
        if changelogs:
            out += ["Upstream changes: " + ", ".join(
                f"[{os.path.basename(u)}]({u})" for u in changelogs), ""]

        if staged.conflict:
            out += self.conflict_help(staged)
        else:
            if staged.range_diff:
                out += ["### Patch stack", "",
                        "<details><summary>umpf range-diff</summary>", "", "```diff",
                        truncate(range_diff_markdown(staged.range_diff.rstrip())), "```", "",
                        "</details>", ""]
            if entry.defconfig:
                out += ["### Kernel configuration", ""]
                make = f"`make {self.make_target()}`"
                if entry.container:
                    make += f" in `{entry.container.image}`"
                if staged.kconfig_diff:
                    out += [f"{make} changed `{entry.defconfig}`:", "",
                            "<details><summary>diffconfig</summary>", "", "```diff",
                            truncate(staged.kconfig_diff.rstrip()), "```", "",
                            "</details>", ""]
                elif staged.kconfig_diff is not None:
                    out += [f"{make} changed `{entry.defconfig}`, but no option: only "
                            "comments, like the version in the header, or the order.", ""]
                elif entry.savedefconfig:
                    out += [f"{make} did not change `{entry.defconfig}`: {staged.base} "
                            "changes none of its options, nor the defaults it relies on.", ""]
                else:
                    out += [f"{make} did not change `{entry.defconfig}`.", ""]
                if staged.kconfig_kept:
                    width = max(len(k[0]) for k in staged.kconfig_kept)
                    out += [f"{len(staged.kconfig_kept)} option(s) are kept as they are: "
                            f"{make} changes them for {staged.old.version} as well, so it is "
                            "due to the environment, e.g. a different compiler or a missing "
                            "Rust toolchain, and not due to the update.", "",
                            "<details><summary>kept options (checked in -> "
                            f"{'container' if entry.container else 'runner'})</summary>",
                            "", "```",
                            truncate("\n".join(f"{n:{width}} {c} -> {b}"
                                                for n, c, b in staged.kconfig_kept)),
                            "```", "", "</details>", ""]
            fetch, with_umpf, plain = self.review_commands(staged)
            out += ["### Reviewing", "", "To review the changes to the patch stack:", "",
                    "```sh", *fetch]
            if with_umpf:
                out += [with_umpf, "# or, without umpf:"]
            out += [plain, "```", ""]

        out += ["---", "<sub>Created by umpfabot stable-update. Pushing to this branch is "
                "fine: umpfabot will then leave this pull request alone and stop "
                "updating it.</sub>"]
        return "\n".join(out) + "\n"

    def conflict_help(self, staged: Staged) -> list[str]:
        entry = self.entry
        c = staged.conflict
        topic = c.topic or "<topic>"
        branch = entry.branch(staged.base)
        lines = ["### Conflict", "",
                 f"The patch stack does not apply on top of {staged.base}. Only "
                 f"{self.updated_vars().replace('UMPF_BASE', '`UMPF_BASE`')} updated "
                 "here, so the build is expected to fail in `do_patch`.",
                 "", "```", self.conflict_text(staged), "```", "",
                 "<details><summary>umpf output</summary>", "", "```",
                 truncate(c.log.strip(), 10000), "```", "", "</details>", "",
                 "### Resolving", "",
                 "1. Check out this pull request in the BSP (`<bsp>` below):", "",
                 "   ```sh", f"   git fetch origin && git checkout {branch}", "   ```", "",
                 f"2. In the umpf repository, update the topic branch `{topic}` so it "
                 f"applies on {staged.base}, e.g. by rebasing it or by adding a fix, and "
                 "create a new umpf with it:", "",
                 "   ```sh",
                 f"   git fetch {entry.repository} --tags",
                 f"   git checkout -b {topic} {self.hashinfo(staged.old, c.topic)}",
                 f"   git rebase {staged.base}    # or fix it in some other way",
                 f"   umpf --identical --override={topic}={topic} --base={staged.base} \\",
                 f"       tag <bsp>/{entry.series}",
                 f"   umpf format-patch --bb --update --patchdir=<bsp>/{entry.patch_dir}",
                 "   utag=\"$(git describe --exact-match)\"",
                 f"   git push {entry.repository} \"$utag\" \"$utag-flat\"",
                 "   ```", ""]
        if entry.defconfig:
            setup = f"<sdk>/{entry.sdk.environment_setup}" if entry.sdk else None
            script = self.kconfig_script(setup).rstrip("\n").split("\n")
            if entry.container:
                where = f"in the container `{entry.container.image}`"
                run_script = ['docker run --rm -i --security-opt label=disable \\',
                              '    -v "$PWD:$PWD:ro" -w "$PWD" \\']
                if entry.sdk:
                    run_script += ["    -v <sdk>:<sdk>:ro \\"]
                run_script += [f"    --entrypoint bash {entry.container.image} \\"]
            else:
                where = "on your machine"
                run_script = ["bash \\"]
            defconfig = f"<bsp>/{entry.defconfig}"
            lines += [f"3. Update the kernel configuration {where}, in the kernel checkout "
                      "at the new umpf:", "", "   ```sh",
                      *[f"   {line}" for line in run_script],
                      "     -c \"$(cat <<'KCONFIG'",
                      *[f"   {line}" for line in script],
                      "   KCONFIG",
                      f"   )\" < {defconfig} > {defconfig}.new",
                      f"   mv {defconfig}.new {defconfig}", "   ```", "",
                      "   Unlike umpfabot, this doesn't keep the options that `make` changes "
                      "for the old umpf as well, e.g. because of a different compiler, so "
                      "check what changed in the defconfig.", ""]
        changed = " ".join(p for p in (entry.patch_dir, entry.defconfig) if p)
        lines += [f"{4 if entry.defconfig else 3}. Amend the commit of this pull request, "
                  "force-push it and mark the pull request as ready for review:", "",
                  "   ```sh", f"   git add -A {changed}", "   git commit --amend",
                  f"   git push --force origin HEAD:{branch}", "   ```", "",
                  "Once the pull request is merged, the topic branches are updated from "
                  "the new umpf as usual. Newer stable updates are only stacked on top of "
                  "this pull request once it is ready for review.", ""]
        return lines

    @staticmethod
    def hashinfo(series: Series, topic: str | None) -> str:
        if topic:
            m = re.search(rf"^# umpf-(?:squash-)?topic: {re.escape(topic)}\n"
                          r"# umpf-hashinfo: (\S+)", series.text, re.M)
            if m:
                return m.group(1)
        return "<hashinfo>"

    ### publishing ###

    def publish(self, staged: Staged, branch: str, expected: str | None) -> str:
        """push the umpf tags, then the BSP branch; returns the published commit

        expected is the commit the branch must currently point to, None if it
        must not exist."""
        repo = self.ctx.umpf_repo(self.entry.repository)
        if self.ctx.dry_run:
            info(f"dry-run: would push {', '.join(staged.push_tags) or 'no tags'} to "
                 f"{self.entry.repository} and {staged.commit[:12]} to {branch}")
        else:
            if staged.push_tags:
                repo.git("push", "-q", "--atomic", "origin",
                         *[f"refs/tags/{t}:refs/tags/{t}" for t in staged.push_tags])
            # don't overwrite what a developer may have pushed in the meantime
            self.ctx.bsp("push", "-q", f"--force-with-lease=refs/heads/{branch}:{expected or ''}",
                         self.ctx.bsp_remote, f"{staged.commit}:refs/heads/{branch}")
            self.ctx.bsp("update-ref", f"refs/remotes/{self.ctx.bsp_remote}/{branch}",
                         staged.commit)
        self.ctx.tips[branch] = staged.commit
        return staged.commit

    def delete_branch(self, pr: PullRequest) -> None:
        if self.ctx.dry_run:
            info(f"dry-run: would delete {pr.head}")
            return
        self.ctx.bsp("push", "-q", f"--force-with-lease=refs/heads/{pr.head}:{pr.head_sha}",
                     self.ctx.bsp_remote, f":refs/heads/{pr.head}", check=False)

    ### pull request handling ###

    def target_of(self, pr: PullRequest) -> str:
        return pr.target(self.entry.branch_prefix)

    def open_pr(self, staged: Staged, parent: str) -> PullRequest | None:
        entry = self.entry
        branch = entry.branch(staged.base)
        expected = self.ctx.bsp_heads().get(branch)
        head = self.publish(staged, branch, expected)
        pr = self.ctx.forge.create_pull(branch, parent, self.subject(staged.base),
                                        self.pr_body(staged, head, parent),
                                        draft=staged.conflict is not None)
        self.ctx.forge.decorate(pr, entry.labels, entry.reviewers, entry.assignees)
        notice(f"{entry.id}: opened {'draft ' if staged.conflict else ''}pull request "
               f"#{pr.number} for {staged.base} ({pr.url})")
        self.prs.append(pr)
        return pr

    def refresh(self, pr: PullRequest, reason: str) -> None:
        """regenerate an unedited pull request on top of its (changed) base"""
        meta = pr.meta
        parent_series = Series(self.ctx.bsp.show(self.ctx.tip(pr.base), self.entry.series),
                               self.entry.series)
        reuse = meta["to"]["umpf"] if parent_series.version == meta["from"]["umpf"] else None
        staged = self.stage(self.ctx.tip(pr.base), self.target_of(pr), reuse)
        head = self.publish(staged, pr.head, pr.head_sha)
        body = self.pr_body(staged, head, pr.base)
        self.ctx.forge.update_pull(pr, title=self.subject(staged.base), body=body)
        conflict = staged.conflict is not None
        if meta.get("conflict", False) != conflict and pr.draft != conflict:
            self.ctx.forge.set_draft(pr, conflict)
            pr.draft = conflict
        pr.head_sha = head
        pr.body = body
        self.ctx.forge.comment(pr, f"Recreated on top of `{pr.base}`: {reason}.")
        notice(f"{self.entry.id}: recreated #{pr.number} ({reason})")

    def close(self, pr: PullRequest, comment: str) -> None:
        # deleting the base branch of a pull request closes it
        for other in self.prs:
            if other.base == pr.head:
                self.ctx.forge.update_pull(other, base=pr.base)
                notice(f"{self.entry.id}: changed base of #{other.number} from "
                       f"{other.base} to {pr.base}")
                other.base = pr.base
        self.ctx.forge.comment(pr, comment)
        self.ctx.forge.update_pull(pr, state="closed")
        self.delete_branch(pr)
        self.prs.remove(pr)

    def ordered(self) -> list[PullRequest]:
        return sorted(self.prs, key=lambda pr: version_key(
            self.strip_prefix(self.target_of(pr)) or self.target_of(pr)))

    @property
    def stacked_on(self) -> dict[str, PullRequest]:
        return {pr.head: pr for pr in self.prs}

    def run(self, version: str | None, force: bool) -> None:
        ctx = self.ctx
        entry = self.entry
        target = entry.target_branch or ctx.forge.default_branch()
        self.prs = ctx.forge.pulls(entry.branch_prefix)
        main = Series(ctx.bsp.show(ctx.tip(target), entry.series) or "", entry.series)
        info(f"{entry.id}: {target} is at {main.version} ({main.base}), "
             f"{len(self.prs)} open pull request(s)")

        # a lower pull request of a stack was merged or closed
        for pr in self.prs:
            if pr.base.startswith(entry.branch_prefix) and pr.base not in self.stacked_on:
                ctx.forge.update_pull(pr, base=target)
                notice(f"{entry.id}: changed base of #{pr.number} from {pr.base} to {target}")
                pr.base = target

        # main was updated to this version (or later) in some other way
        for pr in list(self.ordered()):
            if self.newer(self.target_of(pr), main.base):
                continue
            text = (f"{target} is already at {main.base}, so this pull request is "
                    "no longer needed.")
            if pr.edited:
                comment_once(ctx.forge, pr, f"obsolete:{main.base}", text)
            else:
                self.close(pr, text)
                notice(f"{entry.id}: closed #{pr.number}, {target} is at {main.base}")

        newest = self.select(main, version, force)

        top = self.ordered()[-1] if self.prs else None
        supersede = None
        create = newest is not None
        if create and top:
            # a draft with an unresolved conflict is no base to stack on
            conflict = top.draft and (top.meta or {}).get("conflict", False)
            if entry.pending == "supersede" or conflict:
                if top.edited:
                    comment_once(ctx.forge, top, f"newer:{newest}",
                                 f"{newest} is available, but since this pull request "
                                 "has been edited by someone other than umpfabot, it was "
                                 "not updated. A pull request for the newer version will "
                                 "be opened once this one is merged or closed.")
                    notice(f"{entry.id}: {newest} is available, but #{top.number} was edited")
                    create = False
                else:
                    supersede = top
            elif len(self.prs) >= entry.open_pull_requests_limit:
                notice(f"{entry.id}: {newest} is available, but there are already "
                       f"{len(self.prs)} open pull requests")
                create = False

        # recreate unedited pull requests whose base changed, from the bottom up
        for pr in self.ordered():
            if pr is supersede:
                continue
            parent_tip = ctx.tip(pr.base)
            parent = Series(ctx.bsp.show(parent_tip, entry.series) or "", entry.series)
            meta = pr.meta or {}
            if meta.get("from", {}).get("umpf") not in (None, parent.version):
                reason = f"{pr.base} now has {parent.version}"
            elif pr.mergeable is False:
                reason = f"it conflicted with {pr.base}"
            elif (pr.base.startswith(entry.branch_prefix) and
                  not ctx.bsp.ok("merge-base", "--is-ancestor", parent_tip, pr.head_sha)):
                # main moving on is fine, but stacked ones must follow their base
                reason = f"{pr.base} was updated"
            else:
                continue
            if pr.edited:
                comment_once(ctx.forge, pr, f"stale:{reason}",
                             f"This pull request is out of date ({reason}), but since it "
                             "has been edited by someone other than umpfabot, it was not "
                             "recreated.")
                notice(f"{entry.id}: #{pr.number} is out of date, but was edited")
            else:
                self.refresh(pr, reason)

        if not create:
            return
        parent = target
        if supersede:
            parent = supersede.base
        elif top:
            parent = top.head
        staged = self.stage(ctx.tip(parent), newest)
        pr = self.open_pr(staged, parent)
        if supersede:
            self.close(supersede, f"Superseded by #{pr.number}.")
            notice(f"{entry.id}: closed #{supersede.number}, superseded by #{pr.number}")
        elif top:
            comment_once(ctx.forge, top, f"stacked:{newest}",
                         f"{newest} is available, #{pr.number} is stacked on top of this "
                         "pull request.")

    def select(self, main: Series, version: str | None, force: bool) -> str | None:
        """the stable release to open a new pull request for, if any"""
        entry = self.entry
        tags = self.stable_tags(main.base)
        current = max([main.base] + [self.target_of(pr) for pr in self.prs],
                      key=lambda t: version_key(self.strip_prefix(t) or t))
        if version:
            if version not in tags:
                raise Error(f"{entry.id}: {version} is not a stable release of {main.base}")
            if not self.newer(version, current):
                notice(f"{entry.id}: {version} is not newer than {current}")
                return None
            newest = version
        else:
            if not tags or not self.newer(tags[-1], current):
                info(f"{entry.id}: {current} is up to date")
                return None
            newest = tags[-1]
        closed = [pr for pr in self.ctx.forge.closed_pulls(entry.branch(newest))
                  if not pr.merged]
        if closed and not force:
            notice(f"{entry.id}: skipping {newest}, #{closed[-1].number} was closed "
                   "without merging")
            return None
        if entry.tarball_url:
            url = format_url(entry.tarball_url, newest, self.strip_prefix(newest), entry.id)
            if self.ctx.sha256(url) is None:
                notice(f"{entry.id}: {newest} is released, but {url} is not available yet")
                return None
        return newest


def cmd_stable_update(ctx: Context, args) -> int:
    entries = ctx.entries
    if args.id:
        entries = [e for e in entries if e.id == args.id]
        if not entries:
            raise Error(f"no {FEATURE} entry with id '{args.id}'")
    if args.version and len(entries) != 1:
        raise Error("--version requires --id")
    if not entries:
        info(f"no {FEATURE} entries configured")
        return 0

    ctx.bsp("worktree", "prune")
    info(f"fetching {ctx.bsp_remote}...")
    ctx.bsp("fetch", "-q", "--prune", ctx.bsp_remote,
            f"+refs/heads/*:refs/remotes/{ctx.bsp_remote}/*")
    failed = 0
    for entry in entries:
        try:
            StableUpdate(ctx, entry).run(args.version, args.force)
        except Error as e:
            failed += 1
            msg = f"{entry.id}: {e}"
            if github_actions():
                print(f"::error::{msg.splitlines()[0]}", flush=True)
            info(msg)
            SUMMARY.append(f"error: {msg.splitlines()[0]}")
    return 1 if failed else 0


def write_summary() -> None:
    path = os.environ.get("GITHUB_STEP_SUMMARY")
    if not path or not SUMMARY:
        return
    with open(path, "a") as f:
        f.write("## umpfabot\n\n" + "".join(f"- {line}\n" for line in SUMMARY))


def main() -> int:
    global VERBOSE
    parser = argparse.ArgumentParser(
        prog="umpfabot", description="keep umpfs in BSP repositories up to date")
    parser.add_argument("-C", "--bsp-dir", default=".",
                        help="checkout of the BSP repository (default: .)")
    parser.add_argument("--bsp-remote", default="origin",
                        help="remote of the BSP repository (default: origin)")
    parser.add_argument("-c", "--config", help=f"configuration (default: <bsp>/{DEFAULT_CONFIG})")
    parser.add_argument("-w", "--work-dir",
                        default=os.path.join(os.environ.get("XDG_CACHE_HOME") or
                                             os.path.expanduser("~/.cache"), "umpfabot"),
                        help="directory for clones, SDKs and downloads; worth caching")
    parser.add_argument("--repo", help="GitHub repository of the BSP as owner/name "
                        "(default: $GITHUB_REPOSITORY or derived from the remote)")
    parser.add_argument("--token", help="GitHub token (default: $UMPFABOT_TOKEN, "
                        "$GH_TOKEN or $GITHUB_TOKEN)")
    parser.add_argument("--umpf", metavar="PATH",
                        help="use this umpf executable instead of the configured version")
    parser.add_argument("-n", "--dry-run", action="store_true",
                        help="stage everything, but neither push nor modify pull requests")
    parser.add_argument("--forge-state", metavar="FILE", help=argparse.SUPPRESS)
    parser.add_argument("-v", "--verbose", action="store_true")
    sub = parser.add_subparsers(dest="command", required=True, metavar="<command>")

    p = sub.add_parser(FEATURE, help="update umpfs to the newest upstream stable release")
    p.add_argument("--id", help="only handle the entry with this id")
    p.add_argument("--version", help="update to this release instead of the newest one "
                   "(requires --id)")
    p.add_argument("--force", action="store_true",
                   help="update even if a pull request for the version was closed")
    # also accepted after the command
    p.add_argument("-n", "--dry-run", action="store_true", default=argparse.SUPPRESS,
                   help=argparse.SUPPRESS)
    p.add_argument("-v", "--verbose", action="store_true", default=argparse.SUPPRESS,
                   help=argparse.SUPPRESS)
    p.set_defaults(func=cmd_stable_update)

    args = parser.parse_args()
    VERBOSE = args.verbose
    try:
        ctx = Context(args)
        return args.func(ctx, args)
    except Error as e:
        if github_actions():
            print(f"::error::{str(e).splitlines()[0]}", flush=True)
        info(str(e))
        return 1
    finally:
        write_summary()


if __name__ == "__main__":
    sys.exit(main())
