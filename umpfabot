@dataclasses.dataclass
class PullRequest:
    number: int
    title: str
    body: str
    head: str
    head_sha: str
    base: str
    state: str
    merged: bool
    draft: bool
    url: str
    node_id: str = ""
    mergeable: bool | None = None

    @property
    def meta(self) -> dict | None:
        m = METADATA_RE.search(self.body or "")
        if not m:
            return None
        try:
            return json.loads(m.group(1))
        except json.JSONDecodeError:
            return None

    @property
    def edited(self) -> bool:
        """pushed to by someone else since umpfabot last updated it"""
        meta = self.meta
        return meta is None or meta.get("head") != self.head_sha

    def target(self, prefix: str) -> str:
        meta = self.meta
        if meta and meta.get("to", {}).get("base"):
            return meta["to"]["base"]
        return self.head[len(prefix):]


class GitHub:
    def __init__(self, repo: str, token: str | None, api_url: str, graphql_url: str,
                 dry_run: bool):
        self.repo = repo
        self.token = token
        self.api_url = api_url.rstrip("/")
        self.graphql_url = graphql_url
        self.dry_run = dry_run
        self.owner = repo.split("/")[0]

    def request(self, method: str, url: str, data=None):
        if not url.startswith("http"):
            url = f"{self.api_url}/{url.lstrip('/')}"
        headers = {"Accept": "application/vnd.github+json",
                   "X-GitHub-Api-Version": "2022-11-28",
                   "User-Agent": "umpfabot"}
        if self.token:
            headers["Authorization"] = f"Bearer {self.token}"
        body = None
        if data is not None:
            body = json.dumps(data).encode()
            headers["Content-Type"] = "application/json"
        if VERBOSE:
            info(f"+ {method} {url}")
        req = urllib.request.Request(url, data=body, headers=headers, method=method)
        try:
            with urllib.request.urlopen(req) as resp:
                content = resp.read()
                return json.loads(content) if content else None, resp.headers
        except urllib.error.HTTPError as e:
            raise Error(f"{method} {url} failed: {e.code} {e.reason}: "
                        f"{e.read().decode(errors='replace')}") from e

    def paginate(self, path: str) -> list:
        sep = "&" if "?" in path else "?"
        url = f"{path}{sep}per_page=100"
        items = []
        while url:
            data, headers = self.request("GET", url)
            items += data
            m = re.search(r'<([^>]+)>;\s*rel="next"', headers.get("Link") or "")
            url = m.group(1) if m else None
        return items

    def _pr(self, d: dict) -> PullRequest:
        return PullRequest(number=d["number"], title=d["title"], body=d.get("body") or "",
                           head=d["head"]["ref"], head_sha=d["head"]["sha"],
                           base=d["base"]["ref"], state=d["state"],
                           merged=bool(d.get("merged_at")), draft=bool(d.get("draft")),
                           url=d["html_url"], node_id=d.get("node_id", ""),
                           mergeable=d.get("mergeable"))

    def default_branch(self) -> str:
        return self.request("GET", f"repos/{self.repo}")[0]["default_branch"]

    def pulls(self, prefix: str) -> list[PullRequest]:
        """open pull requests from branches starting with prefix in this repository"""
        prs = []
        for d in self.paginate(f"repos/{self.repo}/pulls?state=open"):
            repo = (d["head"].get("repo") or {}).get("full_name")
            if repo == self.repo and d["head"]["ref"].startswith(prefix):
                # only the single pull request API reports mergeability
                prs.append(self._pr(self.request(
                    "GET", f"repos/{self.repo}/pulls/{d['number']}")[0]))
        return prs

    def closed_pulls(self, branch: str) -> list[PullRequest]:
        head = urllib.parse.quote(f"{self.owner}:{branch}")
        return [self._pr(d) for d in
                self.paginate(f"repos/{self.repo}/pulls?state=closed&head={head}")]

    def create_pull(self, head: str, base: str, title: str, body: str,
                    draft: bool) -> PullRequest:
        data = self.request("POST", f"repos/{self.repo}/pulls", {
            "head": head, "base": base, "title": title, "body": body, "draft": draft,
            "maintainer_can_modify": True})[0]
        return self._pr(data)

    def update_pull(self, pr: PullRequest, **fields) -> None:
        self.request("PATCH", f"repos/{self.repo}/pulls/{pr.number}", fields)

    def set_draft(self, pr: PullRequest, draft: bool) -> None:
        mutation = "convertPullRequestToDraft" if draft else "markPullRequestReadyForReview"
        query = (f"mutation($id: ID!) {{ {mutation}(input: {{pullRequestId: $id}}) "
                 "{ clientMutationId } }")
        data, _ = self.request("POST", self.graphql_url,
                               {"query": query, "variables": {"id": pr.node_id}})
        if data and data.get("errors"):
            raise Error(f"{mutation} failed: {data['errors']}")

    def comments(self, pr: PullRequest) -> list[str]:
        return [c["body"] for c in
                self.paginate(f"repos/{self.repo}/issues/{pr.number}/comments")]

    def comment(self, pr: PullRequest, body: str) -> None:
        self.request("POST", f"repos/{self.repo}/issues/{pr.number}/comments", {"body": body})

    def decorate(self, pr: PullRequest, labels: list[str], reviewers: list[str],
                 assignees: list[str]) -> None:
        if labels:
            self.request("POST", f"repos/{self.repo}/issues/{pr.number}/labels",
                         {"labels": labels})
        if assignees:
            self.request("POST", f"repos/{self.repo}/issues/{pr.number}/assignees",
                         {"assignees": assignees})
        if reviewers:
            self.request("POST", f"repos/{self.repo}/pulls/{pr.number}/requested_reviewers", {
                "reviewers": [r for r in reviewers if "/" not in r],
                "team_reviewers": [r.split("/", 1)[1] for r in reviewers if "/" in r]})


class LocalForge:
    """pull requests kept in a JSON file, for testing and offline use

    Head commits are looked up in the BSP remote, like on a real forge."""

    def __init__(self, path: str, remote_heads):
        self.path = path
        self.remote_heads = remote_heads
        self.dry_run = False
        if os.path.exists(path):
            with open(path) as f:
                self.state = json.load(f)
        else:
            self.state = {}
        self.state.setdefault("default_branch", "main")
        self.state.setdefault("pulls", [])
        self.state.setdefault("comments", {})

    def save(self) -> None:
        with open(self.path, "w") as f:
            json.dump(self.state, f, indent=2)

    def _pr(self, d: dict) -> PullRequest:
        if d["state"] == "open":
            d["head_sha"] = self.remote_heads().get(d["head"], d["head_sha"])
        return PullRequest(number=d["number"], title=d["title"], body=d["body"],
                           head=d["head"], head_sha=d["head_sha"], base=d["base"],
                           state=d["state"], merged=d.get("merged", False),
                           draft=d.get("draft", False), url=f"local:{d['number']}",
                           mergeable=d.get("mergeable"))

    def _find(self, pr: PullRequest) -> dict:
        return next(d for d in self.state["pulls"] if d["number"] == pr.number)

    def default_branch(self) -> str:
        return self.state["default_branch"]

    def pulls(self, prefix: str) -> list[PullRequest]:
        return [self._pr(d) for d in self.state["pulls"]
                if d["state"] == "open" and d["head"].startswith(prefix)]

    def closed_pulls(self, branch: str) -> list[PullRequest]:
        return [self._pr(d) for d in self.state["pulls"]
                if d["state"] == "closed" and d["head"] == branch]

    def create_pull(self, head, base, title, body, draft) -> PullRequest:
        d = {"number": len(self.state["pulls"]) + 1, "title": title, "body": body,
             "head": head, "head_sha": self.remote_heads()[head], "base": base,
             "state": "open", "merged": False, "draft": draft, "labels": [],
             "reviewers": [], "assignees": []}
        self.state["pulls"].append(d)
        self.save()
        return self._pr(d)

    def update_pull(self, pr: PullRequest, **fields) -> None:
        self._find(pr).update(fields)
        self.save()

    def set_draft(self, pr: PullRequest, draft: bool) -> None:
        self._find(pr)["draft"] = draft
        self.save()

    def comments(self, pr: PullRequest) -> list[str]:
        return self.state["comments"].get(str(pr.number), [])

    def comment(self, pr: PullRequest, body: str) -> None:
        self.state["comments"].setdefault(str(pr.number), []).append(body)
        self.save()

    def decorate(self, pr: PullRequest, labels, reviewers, assignees) -> None:
        d = self._find(pr)
        d["labels"] += labels
        d["reviewers"] += reviewers
        d["assignees"] += assignees
        self.save()


class DryRunForge:
    """read from the real forge, but only report modifications"""

    def __init__(self, forge):
        self.forge = forge
        self.dry_run = True
        self.number = 0

    def default_branch(self):
        return self.forge.default_branch()

    def pulls(self, prefix):
        return self.forge.pulls(prefix)

    def closed_pulls(self, branch):
        return self.forge.closed_pulls(branch)

    def comments(self, pr):
        return self.forge.comments(pr) if pr.number > 0 else []

    def create_pull(self, head, base, title, body, draft) -> PullRequest:
        self.number -= 1
        info(f"dry-run: would create {'draft ' if draft else ''}pull request "
             f"'{title}' from {head} to {base}")
        return PullRequest(number=self.number, title=title, body=body, head=head,
                           head_sha="", base=base, state="open", merged=False,
                           draft=draft, url="(dry-run)")

    def update_pull(self, pr, **fields):
        info(f"dry-run: would update #{pr.number}: {', '.join(fields)}")

    def set_draft(self, pr, draft):
        info(f"dry-run: would mark #{pr.number} as {'draft' if draft else 'ready'}")

    def comment(self, pr, body):
        info(f"dry-run: would comment on #{pr.number}: {body.splitlines()[0]}")

    def decorate(self, pr, labels, reviewers, assignees):
        pass


def comment_once(forge, pr: PullRequest, key: str, body: str) -> None:
    """comment unless a comment with the same key was posted before"""
    marker = f"<!-- umpfabot-comment: {key} -->"
    if any(marker in c for c in forge.comments(pr)):
        return
    forge.comment(pr, f"{body}\n\n{marker}")


### the umpf repository ###

@dataclasses.dataclass
class Conflict:
    topic: str | None
    commit: str | None
    files: list[str]
    log: str


class UmpfConflict(Exception):
    def __init__(self, conflict: Conflict):
        super().__init__("conflict")
        self.conflict = conflict


class UmpfRepo:
    """umpfabot's own clone of the repository the umpf tags live in"""

    def __init__(self, ctx: Context, url: str):
        self.ctx = ctx
        self.url = url
        slug = re.sub(r"[^A-Za-z0-9._-]+", "_", url).strip("_")
        self.path = os.path.join(ctx.work_dir, "repos", slug)
        self.git = Git(self.path, ctx.git_env)
        self.fetched = False

    def prepare(self) -> None:
        if self.fetched:
            return
        if not os.path.isdir(os.path.join(self.path, ".git")):
            os.makedirs(self.path, exist_ok=True)
            self.git("init", "-q")
            self.git("remote", "add", "origin", self.url)
            # like 'git clone --filter=blob:none': file contents are only
            # fetched when needed, a full history of Linux is big
            self.git("config", "remote.origin.promisor", "true")
            self.git("config", "remote.origin.partialclonefilter", "blob:none")
        name, email = parse_author(self.ctx.author)
        self.git("config", "user.name", name)
        self.git("config", "user.email", email)
        self.git("config", "remote.origin.url", self.url)
        self.reset()
        info(f"fetching {self.url}...")
        # prune to forget tags of unpublished (dry-run) or failed runs
        self.git("fetch", "-q", "--prune", "--no-tags", "origin", "+refs/tags/*:refs/tags/*",
                 "+refs/heads/*:refs/remotes/origin/*")
        self.fetched = True

    def reset(self) -> None:
        if os.path.isdir(os.path.join(self.path, ".git", "umpf")):
            self.umpf("abort", check=False)
        for state in ("rebase-merge", "rebase-apply"):
            if os.path.isdir(os.path.join(self.path, ".git", state)):
                self.git("rebase", "--abort", check=False)
        if self.git.rev("HEAD"):
            self.git("checkout", "-q", "-f", "--detach")
            self.git("clean", "-q", "-f", "-d", "-x")

    def umpf(self, *args: str, check: bool = True,
             env: dict | None = None) -> subprocess.CompletedProcess:
        return run([self.ctx.umpf, *args], cwd=self.path, env=env or self.git.env,
                   check=check, input="")

    def has_tag(self, tag: str) -> bool:
        return self.git.rev(f"refs/tags/{tag}") is not None

    def ensure_tag(self, tag: str, upstream: str | None) -> None:
        """make sure a base tag exists locally, fetching it from upstream if needed"""
        if self.has_tag(tag):
            return
        if upstream:
            info(f"fetching {tag} from {upstream}...")
            self.git("fetch", "-q", "--no-tags", upstream, f"+refs/tags/{tag}:refs/tags/{tag}")
        else:
            raise Error(f"tag {tag} not found in {self.url}")

    def missing_remote_tags(self, tags: list[str]) -> list[str]:
        present = self.git.remote_refs("origin", *[f"refs/tags/{t}" for t in tags])
        return [t for t in tags if f"refs/tags/{t}" not in present]

    def free_version(self, name: str, date: str, start: int) -> int:
        """the first unused -v <version> >= start for an umpf tag of today"""
        used = set()
        for tag in self.git("tag", "-l", f"{name}/{date}*").splitlines():
            m = re.fullmatch(re.escape(f"{name}/{date}") + r"[-.](\d+)(-flat)?", tag)
            if m:
                used.add(int(m.group(1)))
        version = start
        while version in used:
            version += 1
        return version

    def tag(self, series_file: str, base: str, version: int, epoch: int) -> str:
        """run 'umpf tag' and return the new utag

        Raises UmpfConflict if the topics don't apply on base."""
        env = dict(self.git.env, SOURCE_DATE_EPOCH=str(epoch), TZ="UTC")
        proc = self.umpf("--default", "--identical", f"--base={base}",
                         f"--version={version}", "tag", series_file, check=False, env=env)
        log = proc.stdout + proc.stderr
        if VERBOSE or proc.returncode != 0:
            print(log, file=sys.stderr)
        if proc.returncode == 0:
            m = re.search(r"^# umpf-version: (\S+)$", proc.stdout, re.M)
            if not m or not self.has_tag(m.group(1)):
                raise Error(f"umpf tag did not create a tag:\n{log}")
            return m.group(1)
        files = self.git("diff", "--name-only", "--diff-filter=U").split()
        commit = None
        if self.git.rev("REBASE_HEAD"):
            commit = self.git("log", "-1", "--abbrev=12", "--format=%h (\"%s\")",
                              "REBASE_HEAD")
        topic = None
        for m in re.finditer(r"^# umpf-(?:squash-)?topic: (.*)$", proc.stdout, re.M):
            topic = m.group(1)
        self.umpf("abort", check=False)
        self.reset()
        if commit or files:
            raise UmpfConflict(Conflict(topic=topic, commit=commit, files=files, log=log))
        raise Error(f"umpf tag failed:\n{log}")


def umpf_patches() -> list[str]:
    """patches for umpf that are not upstream yet, applied to the newest umpf"""
    here = os.path.dirname(os.path.realpath(__file__))
    for path in (os.path.join(here, "patches"),
                 os.path.join(here, os.pardir, "share", "umpfabot", "patches")):
        if os.path.isdir(path):
            return sorted(glob.glob(os.path.join(path, "*.patch")))
    return []


CONFIG_LINE_RE = re.compile(r"(CONFIG_[A-Za-z0-9_]+)=.*|# (CONFIG_[A-Za-z0-9_]+) is not set")


def config_option(line: str) -> str | None:
    m = CONFIG_LINE_RE.fullmatch(line)
    return (m[1] or m[2]) if m else None


def config_options(text: str) -> dict[str, str]:
    """the lines of a .config or defconfig by option, in their order"""
    return {o: line for line in text.splitlines() if (o := config_option(line))}


def config_value(line: str | None) -> str:
    if line is None:
        return "-"
    if line.startswith("#"):
        return "n"
    return line.split("=", 1)[1]


def keep_environment(checked_in: str, before: str,
                     after: str) -> tuple[str, list[tuple[str, str, str]]]:
    """The checked-in configuration with the changes from make olddefconfig for the old
    umpf (before) to the new umpf (after) applied. What make olddefconfig changes for
    the old umpf already is due to the environment make runs in, e.g. a different
    compiler, or no Rust toolchain, so it is kept. Returns the configuration and the
    kept options: name, checked-in value and value in the environment."""
    c, b, a = config_options(checked_in), config_options(before), config_options(after)
    kept = [(o[len("CONFIG_"):], config_value(c.get(o)), config_value(b.get(o)))
            for o in sorted({*c, *b}) if c.get(o) != b.get(o) and a.get(o) == b.get(o)]
    update = {o: a.get(o) for o in {*b, *a} if b.get(o) != a.get(o)}

    def header(lines: list[str]) -> int:
        return next((n for n, line in enumerate(lines)
                     if not line.startswith("#") or config_option(line)), len(lines))

    # the header with the version of the new umpf
    after_lines = after.splitlines()
    lines = checked_in.splitlines()
    lines = after_lines[:header(after_lines)] + lines[header(lines):]
    # changed and removed options
    lines = [update.get(o, line) if (o := config_option(line)) else line for line in lines]
    lines = [line for line in lines if line is not None]
    # added options, after what is before them in after, the way Kconfig writes them
    present = {o for line in lines if (o := config_option(line))}
    for i, line in enumerate(after_lines):
        option = config_option(line)
        if option not in update or update[option] is None or option in present:
            continue
        pos = anchor(lines, after_lines, i)
        lines.insert(pos, line)
        present.add(option)
    return normalize_config(lines, after.endswith("\n")), kept


def anchor(lines: list[str], source: list[str], i: int) -> int:
    """where to insert source[i] into lines: after the closest line before it in
    source that is in lines as well, an option or a menu"""
    for prev in reversed(source[:i]):
        if prev in ("", "#"):
            continue
        option = config_option(prev)
        for p, line in enumerate(lines):
            if option and config_option(line) == option or not option and line == prev:
                break
        else:
            continue
        if not option and 0 < p < len(lines) - 1 and lines[p - 1] == lines[p + 1] == "#":
            return p + 2  # into the menu, after its title
        if prev.startswith("# end of "):
            # Kconfig writes an empty line between the end of a menu and an option
            if p + 2 < len(lines) and lines[p + 1] == "" and config_option(lines[p + 2]):
                return p + 2
            lines[p + 1:p + 1] = [""]
            return p + 2
        return p + 1
    return next((p for p, line in enumerate(lines) if config_option(line)), len(lines))


def normalize_config(lines: list[str], newline: bool) -> str:
    """the empty lines as Kconfig writes them: only before an option or a menu"""
    out: list[str] = []
    for n, line in enumerate(lines):
        if line == "" and (not out or out[-1] == "" or n + 1 == len(lines)
                           or not (lines[n + 1] == "#" or config_option(lines[n + 1]))):
            continue
        out.append(line)
    return "\n".join(out) + ("\n" if newline else "")


def range_diff_markdown(text: str) -> str:
    """git range-diff output for a ```diff block on GitHub, which only looks at the
    first column: without the indentation of the patches, the outer diff markers are
    there and get colored. The commit pairs get a space instead, so that '-:' of a
    commit that is only in the new umpf is not shown as removed."""
    out = []
    for line in text.splitlines():
        if line.startswith("    "):
            out.append(line[4:])
        elif line.strip():
            out.append(" " + line)
        else:
            out.append("")
    return "\n".join(out)


def container_engine() -> str:
    for engine in ("docker", "podman"):
        if shutil.which(engine):
            return engine
    raise Error("make olddefconfig runs in a container, but neither docker nor podman was "
                "found. Install one or set 'container: false' to run it on the runner.")


def parse_author(author: str) -> tuple[str, str]:
    m = re.fullmatch(r"\s*(.*?)\s*<([^>]+)>\s*", author)
    if not m:
        raise Error(f"invalid author '{author}', expected 'Name <email>'")
    return m.group(1), m.group(2)


def web_url(url: str) -> str | None:
    m = re.fullmatch(r"(?:https://|ssh://git@|git@)(github\.com)[:/](.+?)(?:\.git)?/?", url)
    return f"https://{m.group(1)}/{m.group(2)}" if m else None


