@dataclasses.dataclass
class Staged:
    """a BSP commit for an update, ready to be published"""
    commit: str
    old: Series
    base: str
    utag: str | None
    conflict: Conflict | None
    kconfig_diff: str | None
    range_diff: str | None
    push_tags: list[str]
