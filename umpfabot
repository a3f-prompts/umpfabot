VERBOSE = False
SUMMARY: list[str] = []


class Error(Exception):
    pass


def github_actions() -> bool:
    return os.environ.get("GITHUB_ACTIONS") == "true"


def info(msg: str) -> None:
    print(f"umpfabot: {msg}", file=sys.stderr, flush=True)


def notice(msg: str) -> None:
    """an action taken or skipped, also added to the job summary"""
    SUMMARY.append(msg)
    if github_actions():
        print(f"::notice::{msg}", flush=True)
    else:
        info(msg)


def warning(msg: str) -> None:
    SUMMARY.append(f"warning: {msg}")
    if github_actions():
        print(f"::warning::{msg}", flush=True)
    else:
        info(f"warning: {msg}")


def run(args: list[str], cwd: str | None = None, env: dict | None = None,
        check: bool = True, input: str | None = None) -> subprocess.CompletedProcess:
    if VERBOSE:
        info(f"+ {shlex.join(args)}" + (f"  (in {cwd})" if cwd else ""))
    proc = subprocess.run(args, cwd=cwd, env=env, input=input, text=True,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if VERBOSE and proc.stderr:
        sys.stderr.write(proc.stderr)
    if check and proc.returncode != 0:
        raise Error(f"'{shlex.join(args)}' failed with exit code {proc.returncode}:\n"
                    f"{proc.stdout}{proc.stderr}".rstrip())
    return proc


class Git:
    def __init__(self, path: str, env: dict | None = None):
        self.path = path
        self.env = env

    def __call__(self, *args: str, check: bool = True, input: str | None = None) -> str:
        return run(["git", *args], cwd=self.path, env=self.env, check=check,
                   input=input).stdout.rstrip("\n")

    def ok(self, *args: str) -> bool:
        return run(["git", *args], cwd=self.path, env=self.env, check=False).returncode == 0

    def rev(self, rev: str) -> str | None:
        out = self("rev-parse", "--verify", "-q", rev + "^{commit}", check=False)
        return out or None

    def show(self, commit: str, path: str) -> str | None:
        proc = run(["git", "show", f"{commit}:{path}"], cwd=self.path, env=self.env, check=False)
        return proc.stdout if proc.returncode == 0 else None

    def remote_refs(self, remote: str, *patterns: str) -> dict[str, str]:
        refs = {}
        for line in self("ls-remote", "--refs", remote, *patterns).splitlines():
            sha, ref = line.split("\t", 1)
            refs[ref] = sha
        return refs


def git_env(token: str | None, server_url: str) -> dict:
    """environment for git: never prompt and authenticate with token, if any

    The token is provided through a credential helper, so it is only used
    if the server asks for credentials, e.g. not if actions/checkout already
    configured an authorization header for the repository."""
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    if token:
        env["UMPFABOT_GIT_TOKEN"] = token
        count = int(env.get("GIT_CONFIG_COUNT", "0"))
        helper = ('!f() { test "$1" = get || return 0; echo username=x-access-token; '
                  'echo "password=${UMPFABOT_GIT_TOKEN}"; }; f')
        # an empty helper resets the list of helpers configured elsewhere
        for i, value in enumerate(("", helper)):
            env[f"GIT_CONFIG_KEY_{count + i}"] = f"credential.{server_url}.helper"
            env[f"GIT_CONFIG_VALUE_{count + i}"] = value
        env["GIT_CONFIG_COUNT"] = str(count + 2)
    return env


### versions ###

def version_key(version: str) -> tuple:
    """sort key compatible with 'sort -V' for the usual release versions"""
    return tuple((0, int(p), "") if p.isdigit() else (1, 0, p)
                 for p in re.findall(r"\d+|[^\d.]+", version))


def format_url(template: str, tag: str, version: str, entry_id: str) -> str:
    parts = version.split(".")
    return template.format(tag=tag, version=version, id=entry_id,
                           major=parts[0], minor=parts[1] if len(parts) > 1 else "",
                           series=".".join(parts[:2]))


