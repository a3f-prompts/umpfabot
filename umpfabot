def _get(d: dict, key: str, kind, default=None, required=False, where=""):
    if key not in d or d[key] is None:
        if required:
            raise Error(f"{where}: '{key}' is required")
        return default
    value = d[key]
    if kind is not None and not isinstance(value, kind):
        raise Error(f"{where}: '{key}' has invalid type {type(value).__name__}")
    return value


