def parse_entry(d: dict, index: int) -> Entry:
    where = f"{FEATURE}[{index}]"
    if not isinstance(d, dict):
        raise Error(f"{where}: must be a mapping")
    entry_id = _get(d, "id", str, required=True, where=where)
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", entry_id):
        raise Error(f"{where}: invalid id '{entry_id}'")
    where = f"{FEATURE}[{entry_id}]"
    series = _get(d, "series", str, required=True, where=where)
    if os.path.basename(series) != "series.inc":
        raise Error(f"{where}: 'series' must point to the series.inc written by "
                    "'umpf format-patch --bb'")

    upstream = _get(d, "upstream", dict, {}, where=where)
    tarball = _get(d, "tarball", dict, {}, where=where)
    kconfig = _get(d, "kconfig", dict, {}, where=where)
    commit = _get(d, "commit-message", dict, {}, where=where)

    sdk = None
    sdk_d = _get(d, "sdk", dict, None, where=where)
    if sdk_d is not None:
        sdk_where = f"{where}.sdk"
        sdk = Sdk(installer=_get(sdk_d, "installer", str, where=sdk_where),
                  sha256=_get(sdk_d, "sha256", str, where=sdk_where),
                  path=_get(sdk_d, "path", str, where=sdk_where),
                  environment_setup=_get(sdk_d, "environment-setup", str,
                                         "environment-setup-*", where=sdk_where),
                  env={str(k): str(v) for k, v in
                       _get(sdk_d, "env", dict, {}, where=sdk_where).items()})
        if sdk.installer and sdk.path:
            raise Error(f"{sdk_where}: 'installer' and 'path' are mutually exclusive")

    # make olddefconfig runs in a container by default, 'container: false' runs it
    # on the runner
    container: Container | None = Container(DEFAULT_CONTAINER_IMAGE,
                                            DEFAULT_CONTAINER_PREPARE)
    container_d = _get(d, "container", None, {}, where=where)
    if container_d is False:
        container = None
    elif container_d is True:
        pass
    elif isinstance(container_d, dict):
        container_where = f"{where}.container"
        container = Container(
            image=_get(container_d, "image", str, DEFAULT_CONTAINER_IMAGE,
                       where=container_where),
            prepare=_get(container_d, "prepare", str, DEFAULT_CONTAINER_PREPARE,
                         where=container_where))
    else:
        raise Error(f"{where}: 'container' must be a mapping or false")

    pending = _get(d, "pending", str, "stack", where=where)
    if pending not in ("stack", "supersede"):
        raise Error(f"{where}: 'pending' must be 'stack' or 'supersede'")

    if tarball and not d.get("recipe"):
        raise Error(f"{where}: 'tarball' requires 'recipe'")
    defconfig = _get(kconfig, "defconfig", str, where=f"{where}.kconfig")
    if kconfig and not defconfig:
        raise Error(f"{where}.kconfig: 'defconfig' is required")

    return Entry(
        id=entry_id,
        series=series,
        recipe=_get(d, "recipe", str, where=where),
        repository=_get(d, "repository", str, required=True, where=where),
        compare_url=_get(d, "compare-url", str, where=where),
        upstream=_get(upstream, "repository", str, where=f"{where}.upstream"),
        tag_prefix=_get(upstream, "tag-prefix", str, "v", where=f"{where}.upstream"),
        stable_version_parts=_get(upstream, "stable-version-parts", int, 2,
                                  where=f"{where}.upstream"),
        stable_release_regex=_get(upstream, "stable-release-regex", str,
                                  where=f"{where}.upstream"),
        changelog_url=_get(upstream, "changelog-url", str, where=f"{where}.upstream"),
        tarball_url=_get(tarball, "url", str, where=f"{where}.tarball"),
        checksum_name=_get(tarball, "checksum-name", str, where=f"{where}.tarball"),
        defconfig=defconfig,
        savedefconfig=_get(kconfig, "savedefconfig", bool, False, where=f"{where}.kconfig"),
        make_args=[str(a) for a in _get(kconfig, "make-args", list, [],
                                        where=f"{where}.kconfig")],
        sdk=sdk,
        container=container,
        tag_version=_get(d, "tag-version", int, 90, where=where),
        target_branch=_get(d, "target-branch", str, where=where),
        pending=pending,
        open_pull_requests_limit=_get(d, "open-pull-requests-limit", int, 5, where=where),
        labels=[str(x) for x in _get(d, "labels", list, [], where=where)],
        reviewers=[str(x) for x in _get(d, "reviewers", list, [], where=where)],
        assignees=[str(x) for x in _get(d, "assignees", list, [], where=where)],
        commit_prefix=_get(commit, "prefix", str, f"{entry_id}: ",
                           where=f"{where}.commit-message"),
        signoff=_get(commit, "signoff", bool, False, where=f"{where}.commit-message"),
    )


@dataclasses.dataclass
class Config:
    author: str
    umpf_repository: str
    umpf_version: str | None
    entries: list[Entry]


def load_config(path: str) -> Config:
    try:
        with open(path) as f:
            data = yaml.safe_load(f) or {}
    except OSError as e:
        raise Error(f"cannot read config: {e}") from e
    except yaml.YAMLError as e:
        raise Error(f"invalid config {path}: {e}") from e
    if not isinstance(data, dict):
        raise Error(f"{path}: must be a mapping")
    if data.get("version", 1) != 1:
        raise Error(f"{path}: unsupported version {data.get('version')}")
    author = _get(data, "author", str, DEFAULT_AUTHOR, where=path)
    umpf = _get(data, "umpf", dict, {}, where=path)
    umpf_version = _get(umpf, "version", str, where=f"{path}: umpf")
    if umpf_version is not None and (not umpf_version or umpf_version.startswith("-")):
        raise Error(f"{path}: umpf: invalid version '{umpf_version}'")
    entries = [parse_entry(d, i) for i, d in enumerate(
        _get(data, FEATURE, list, [], where=path))]
    ids = [e.id for e in entries]
    if len(ids) != len(set(ids)):
        raise Error(f"{path}: duplicate {FEATURE} ids")
    return Config(author=author,
                  umpf_repository=_get(umpf, "repository", str, DEFAULT_UMPF_REPOSITORY,
                                       where=f"{path}: umpf"),
                  umpf_version=umpf_version, entries=entries)


### umpf series ###

class Series:
    """a qualified useries, e.g. the series.inc of 'umpf format-patch --bb'"""

    def __init__(self, text: str, where: str):
        self.text = text
        self.where = where
        for key in ("base", "name", "version"):
            if self.get(key) is None:
                raise Error(f"{where}: no 'umpf-{key}' found. Is this a series of a utag?")

    def get(self, key: str) -> str | None:
        m = re.search(rf"^# umpf-{key}: *(.*?)\s*$", self.text, re.M)
        return m.group(1) if m else None

    @property
    def base(self) -> str:
        return self.get("base")

    @property
    def name(self) -> str:
        return self.get("name")

    @property
    def version(self) -> str:
        """the utag this series was created from"""
        return self.get("version")

    def with_umpf_base(self, base: str) -> str:
        """only point UMPF_BASE to a new base, like 'umpf format-patch --bb' would"""
        text, n = re.subn(r'^(UMPF_BASE\s*=\s*")[^"]*(")',
                          lambda m: m.group(1) + base.replace("v", "") + m.group(2),
                          self.text, flags=re.M)
        if n != 1:
            raise Error(f"{self.where}: expected exactly one UMPF_BASE assignment")
        return text


def update_checksum(text: str, name: str | None, sha256: str, where: str) -> str:
    key = f"{name}.sha256sum" if name else "sha256sum"
    patterns = [re.compile(r'^(\s*SRC_URI\[' + re.escape(key) +
                           r'\]\s*[?:]?=\s*")[0-9a-fA-F]{64}(")', re.M)]
    if not name:
        patterns.append(re.compile(r"(;sha256sum=)[0-9a-fA-F]{64}()"))
    matches = sum(len(p.findall(text)) for p in patterns)
    if matches != 1:
        raise Error(f"{where}: expected exactly one SRC_URI checksum for '{key}', "
                    f"found {matches}. Set 'tarball.checksum-name'?")
    for p in patterns:
        text = p.sub(lambda m: m.group(1) + sha256 + m.group(2), text)
    return text


